# Optional locally; Render generates JWT_SECRET automatically via render.yaml.
NODE_ENV=production
JWT_SECRET=replace-with-a-long-random-secret

# Optional: enables Smart AI routine analysis and RUET-aware AI features
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna


# Optional: password reset email delivery via Resend.
# Without these locally, reset links are printed to the server console for development.
RESEND_API_KEY=
RESEND_FROM_EMAIL=UniFlow <noreply@yourdomain.com>
